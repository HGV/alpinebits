<?xml version="1.0" encoding="UTF-8"?>

<!-- 
    AlpineBits 2026-10
    https://www.alpinebits.org/

    Sample message file for an Inventory Basic request to push room information

    Changelog:
    v. 2026-10 1.1 added AlpineBits ABR room amenity codes next to the OTA ones
    v. 2026-10 1.0 added the optional TypeRoom Size attribute
    v. 2022-10 1.1 reformatting
    v. 2015-07 1.0 initial example
-->

<OTA_HotelDescriptiveContentNotifRQ xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                                    xmlns="http://www.opentravel.org/OTA/2003/05" 
                                    xsi:schemaLocation="http://www.opentravel.org/OTA/2003/05 OTA_HotelDescriptiveContentNotifRQ.xsd" 
                                    Version="8.000">

    <HotelDescriptiveContents>

        <HotelDescriptiveContent HotelCode="123" HotelName="AlpineBits Hotel">

            <FacilityInfo>

                <GuestRooms>

                    <!-- This element defines a category and contains its basic description -->
                    <GuestRoom Code="DOUBLE" MaxOccupancy="3" MinOccupancy="1" MaxChildOccupancy="1"  MaxAdultOccupancy="2">

                        <!-- RoomClassificationCode = "42" means Room, 13 Apartment, see OTA table GRI -->
                        <TypeRoom StandardOccupancy="2" RoomClassificationCode="42" Size="28"/>

                        <Amenities>

                            <!-- 26 means Crib, see OTA table RMA -->
                            <Amenity RoomAmenityCode="26"/>

                            <!--
                            the AlpineBits list ABR can be used alongside the OTA one
                            when RMA has no matching code: 7.ABR is Balcony, 59.ABR is Safe
                            -->
                            <Amenity RoomAmenityCode="7.ABR"/>
                            <Amenity RoomAmenityCode="59.ABR"/>

                        </Amenities>

                        <MultimediaDescriptions>

                            <MultimediaDescription InfoCode="25">
                                <TextItems>
                                    <TextItem>
                                        <Description TextFormat="PlainText" Language="en">Double room</Description>
                                        <Description TextFormat="PlainText" Language="de">Doppelzimmer</Description>
                                        <Description TextFormat="PlainText" Language="it">Camera doppia</Description>
                                    </TextItem>
                                </TextItems>
                            </MultimediaDescription>

                            <MultimediaDescription InfoCode="1">
                                <TextItems>
                                    <TextItem>
                                        <Description TextFormat="PlainText" Language="en">Description of the double room.</Description>
                                        <Description TextFormat="PlainText" Language="de">Doppelzimmer Beschreibung.</Description>
                                        <Description TextFormat="PlainText" Language="it">Descrizione della camera doppia.</Description>
                                    </TextItem>
                                </TextItems>
                            </MultimediaDescription>

                            <MultimediaDescription InfoCode="23">
                                <ImageItems>

                                    <!-- 6 means Guest room, see OTA table PIC -->
                                    <ImageItem Category="6">
                                        <ImageFormat CopyrightNotice="Copyright notice 2015">
                                            <URL>https://www.example.com/image.jpg</URL>
                                        </ImageFormat>
                                        <Description TextFormat="PlainText" Language="en">Picture of the room</Description>
                                        <Description TextFormat="PlainText" Language="de">Zimmerbild</Description>
                                        <Description TextFormat="PlainText" Language="it">Immagine della stanza</Description>
                                    </ImageItem>
                                </ImageItems>
                            </MultimediaDescription>
                        </MultimediaDescriptions>
                            
                    </GuestRoom>

                    <!-- a second category, large enough for a family of four -->
                    <GuestRoom Code="SUITE" MaxOccupancy="4" MinOccupancy="1" MaxChildOccupancy="2" MaxAdultOccupancy="2">

                        <TypeRoom StandardOccupancy="4" RoomClassificationCode="42" Size="46"/>

                        <Amenities>
                            <Amenity RoomAmenityCode="26"/>
                            <Amenity RoomAmenityCode="7.ABR"/>
                            <Amenity RoomAmenityCode="59.ABR"/>
                        </Amenities>

                        <MultimediaDescriptions>

                            <MultimediaDescription InfoCode="25">
                                <TextItems>
                                    <TextItem>
                                        <Description TextFormat="PlainText" Language="en">Suite</Description>
                                        <Description TextFormat="PlainText" Language="de">Suite</Description>
                                        <Description TextFormat="PlainText" Language="it">Suite</Description>
                                    </TextItem>
                                </TextItems>
                            </MultimediaDescription>

                        </MultimediaDescriptions>

                    </GuestRoom>

                    <!-- a third category, for one guest -->
                    <GuestRoom Code="SINGLE" MaxOccupancy="1" MinOccupancy="1">

                        <TypeRoom StandardOccupancy="1" RoomClassificationCode="42" Size="16"/>

                        <MultimediaDescriptions>

                            <MultimediaDescription InfoCode="25">
                                <TextItems>
                                    <TextItem>
                                        <Description TextFormat="PlainText" Language="en">Single room</Description>
                                        <Description TextFormat="PlainText" Language="de">Einzelzimmer</Description>
                                        <Description TextFormat="PlainText" Language="it">Camera singola</Description>
                                    </TextItem>
                                </TextItems>
                            </MultimediaDescription>

                        </MultimediaDescriptions>

                    </GuestRoom>

                    <!-- Following elements define the single Rooms that belong to the Category -->
                    <GuestRoom Code="DOUBLE">
                        <TypeRoom RoomID="101"/>
                    </GuestRoom>

                    <GuestRoom Code="DOUBLE">
                        <TypeRoom RoomID="102"/>
                    </GuestRoom>

                    <GuestRoom Code="DOUBLE">
                        <TypeRoom RoomID="103"/>
                    </GuestRoom>

                    <GuestRoom Code="DOUBLE">
                        <TypeRoom RoomID="104"/>
                    </GuestRoom>

                    <GuestRoom Code="DOUBLE">
                        <TypeRoom RoomID="105"/>
                    </GuestRoom>

                    <GuestRoom Code="SUITE">
                        <TypeRoom RoomID="201"/>
                    </GuestRoom>

                    <GuestRoom Code="SUITE">
                        <TypeRoom RoomID="202"/>
                    </GuestRoom>

                    <GuestRoom Code="SINGLE">
                        <TypeRoom RoomID="301"/>
                    </GuestRoom>

                </GuestRooms>
                            
            </FacilityInfo>

        </HotelDescriptiveContent>

    </HotelDescriptiveContents>

</OTA_HotelDescriptiveContentNotifRQ>
